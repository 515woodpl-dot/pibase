# Nginx reverse proxy for DATBase — needed when something else on this machine already owns
# port 80/443, so scripts/setup-pi.sh moved DATBase's Caddy to an alternate port (CADDY_HTTP_PORT
# in .env). This forwards port-80 traffic to Caddy so the plain http://<domain> URL works without
# typing the port, AND routes project subdomains (*.DOMAIN) automatically.
#
# setup-pi.sh creates this file automatically when it detects port 80 is taken and nginx is
# running — you shouldn't need to touch it. If you do need to set it up manually:
#
#   sudo cp scripts/nginx-datbase.conf.example /etc/nginx/sites-available/datbase
#   sudo nano /etc/nginx/sites-available/datbase   # replace DOMAIN and CADDY_HTTP_PORT
#   sudo ln -s /etc/nginx/sites-available/datbase /etc/nginx/sites-enabled/datbase
#   sudo nginx -t && sudo systemctl reload nginx
#
# Replace DOMAIN with your .env DOMAIN value (e.g. 100-119-190-50.sslip.io), and
# CADDY_HTTP_PORT with the port from .env (e.g. 9081). The wildcard *.DOMAIN is critical:
# without it, project URLs like panda-xyz.100-119-190-50.sslip.io get a 502 because nginx
# doesn't recognise the hostname and never forwards the request to Caddy.

server {
    listen 80;
    server_name DOMAIN *.DOMAIN;

    location / {
        proxy_pass http://127.0.0.1:CADDY_HTTP_PORT;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
