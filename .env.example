# Copy to .env and fill in. Generate each secret once:
#   POSTGRES_PASSWORD, BETTER_AUTH_SECRET:  openssl rand -hex 32
#   ENCRYPTION_KEY (must be base64, 32 bytes): openssl rand -base64 32

# Your domain. Dashboard runs at https://DOMAIN, projects at https://<project>.DOMAIN
DOMAIN=example.com
# https (default: automatic certificates, needs a public domain) or http for a home-network test box.
# Raspberry Pi on your LAN: DOMAIN=192-168-1-50.sslip.io (your Pi's IP with dashes) and PUBLIC_SCHEME=http
# PUBLIC_SCHEME=http

# Host ports for the Caddy proxy. Leave unset for the standard 80/443 (dedicated server). On a
# shared machine where 80/443 are already taken by another service, set these to free ports
# instead — scripts/setup-pi.sh detects conflicts and fills these in for you automatically.
# CADDY_HTTP_PORT=9080
# CADDY_HTTPS_PORT=9443

POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# Per-project container caps. Plan limits (projects, storage, users, requests) live in app/src/lib/plans.ts
PB_MEMORY_MB=128
PB_CPUS=0.5

# PocketBase version every project runs. Stay on 0.39.x until 0.40+ passes tests/e2e/pb-stress.mjs on your server.
PB_VERSION=0.39.11

# How often usage is measured and limits enforced (minutes)
USAGE_INTERVAL_MIN=10

# Backups (DigitalOcean Spaces or any S3-compatible bucket). Leave empty to turn backups off.
# Spaces: create a bucket + access key; endpoint is https://<region>.digitaloceanspaces.com
BACKUP_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
# How often to check for due backups (minutes). Each project is backed up once a day.
BACKUP_CHECK_MIN=15
# Disaster recovery only (see README). Never leave this on.
# RECOVER_ON_START=1

# Email (any SMTP provider: Resend, Brevo, Postmark, Amazon SES, Gmail app password…).
# Turns on: dashboard email confirmation + password reset, and the same for your customers' app users.
# Leave SMTP_HOST empty to run without email (accounts work immediately, no reset emails).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DATBase <no-reply@example.com>"
# SMTP_SECURE=true        # only for port 465
# Emails per hour each project may send to its app users
PROJECT_MAIL_PER_HOUR=50

# Monitoring & alerts
# The DATBase account with this email sees "Server status" in the dashboard and gets alert emails.
ADMIN_EMAIL=matosgeorgen@gmail.com
# Also send alerts here as JSON (Home Assistant webhook, Discord or Slack webhook URL). Optional.
ALERT_WEBHOOK_URL=
# Token for GET /api/monitor (Home Assistant sensors). Generate: openssl rand -hex 32. Empty = endpoint off.
MONITOR_TOKEN=
# Check interval (minutes) and alert thresholds
MONITOR_INTERVAL_MIN=5
MONITOR_DISK_PCT=85
MONITOR_MEM_PCT=90
MONITOR_BACKUP_MAX_AGE_H=36
