# IMPORTANT: Set these ONCE before first run, then never change them.
# They are baked into the Postgres data volume on initialization.
# Rotating POSTGRES_PASSWORD after first run requires changing the password
# inside the running database first (ALTER USER postgres PASSWORD '...'),
# then updating this file. Rotating PIBASE_AUTHENTICATOR_PASSWORD requires
# running: docker compose run --rm ops authenticator-rekey
POSTGRES_PASSWORD=change-me
PIBASE_AUTHENTICATOR_PASSWORD=change-me-too
# Generate with: openssl rand -base64 32
PIBASE_MASTER_KEY=
# Independent keys; generate each with: openssl rand -base64 32
PIBASE_BACKUP_KEY=
PIBASE_OPERATOR_TOKEN=
PIBASE_ENV=production
PIBASE_AUTH_EXPOSE_TOKENS=false
PIBASE_DATA_ROOT=/srv/pibase
PIBASE_UID=
PIBASE_GID=

# Projects one dashboard account may own (each is a full Postgres database).
PIBASE_MAX_PROJECTS_PER_ACCOUNT=2
# Reverse proxies in front of the admin dashboard, as comma-separated IPs or
# CIDRs (e.g. the Docker network 172.18.0.0/16). Their X-Forwarded-For header
# is used for rate limiting; leave empty when nothing sits in front.
PIBASE_TRUSTED_PROXIES=
