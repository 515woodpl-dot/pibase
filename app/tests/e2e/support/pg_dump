#!/bin/sh
# Fake pg_dump for tests: put this folder first in PATH. Mode file: fail | slow | ok
MODE=$(cat "${FAKE_PGDUMP_MODE:-/tmp/datbase-e2e/pgdump-mode}" 2>/dev/null || echo ok)
case "$MODE" in
  fail) echo "pg_dump: simulated connection failure" >&2; exit 1 ;;
  slow) sleep 15 ;;
esac
# The real pg_dump: REAL_PG_DUMP, else $PG_BIN/pg_dump, else the next pg_dump in PATH after this folder.
REAL="${REAL_PG_DUMP:-}"
[ -z "$REAL" ] && [ -n "${PG_BIN:-}" ] && [ -x "$PG_BIN/pg_dump" ] && REAL="$PG_BIN/pg_dump"
if [ -z "$REAL" ]; then
  SELF=$(cd "$(dirname "$0")" && pwd)
  OLDIFS=$IFS; IFS=:
  for d in $PATH; do
    [ "$d" = "$SELF" ] && continue
    [ -x "$d/pg_dump" ] && { REAL="$d/pg_dump"; break; }
  done
  IFS=$OLDIFS
fi
[ -n "$REAL" ] || { echo "pg_dump not found: set PG_BIN or REAL_PG_DUMP" >&2; exit 127; }
exec "$REAL" "$@"
